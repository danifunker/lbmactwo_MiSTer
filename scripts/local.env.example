# Personal/local environment for the LBMacTwo hardware-debug scripts.
# Copy this to scripts/local.env and fill in your own values.
# scripts/local.env is gitignored — do NOT commit it.
#
# Sourced by scripts/deploy_test_floppy.sh and any other helper that
# needs to talk to a real MiSTer or call Quartus.

# Hostname or IP of your MiSTer on the LAN.
export MISTER_HOST="MiSTer.local"

# Absolute path (Unix-style on Windows: /c/...) to the SSH private key
# that the MiSTer accepts. The matching public key must be in
# /media/fat/linux/authorized_keys on the MiSTer.
export MISTER_SSH_KEY="$HOME/.ssh/mister_only"

# Directory containing quartus_stp_tcl / quartus_pgm / etc. for
# reading JTAG probes and (optionally) programming the SOF. Quartus
# 17.0 is what this project's RTL builds against.
export QUARTUS_BIN="/c/intelFPGA_lite/17.0/quartus/bin64"

# Optional: Remote (mrext) HTTP port. 8182 is the default; change
# only if your MiSTer's mrext is on a different port.
export MISTER_HTTP_PORT="8182"
